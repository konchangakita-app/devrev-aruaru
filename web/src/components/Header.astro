---
const nav = [
  { href: '/', label: 'トップ' },
  { href: '/aruaru', label: 'あるある' },
  { href: '/verify', label: '検証してみた' },
  { href: '/about', label: 'About' },
];
---

<header class="border-b border-slate-800 bg-slate-950/90">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4">
    <a href="/" class="text-lg font-semibold text-amber-400">DevRevあるある</a>
    <nav class="flex gap-4 text-sm text-slate-300">
      {nav.map((item) => (
        <a href={item.href} class="hover:text-amber-300">{item.label}</a>
      ))}
    </nav>
  </div>
</header>
