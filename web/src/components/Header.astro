---
const nav = [
  { href: '/aruaru', label: 'あるある' },
  { href: '/verify', label: '検証してみた' },
  { href: '/about', label: 'About' },
];
---

<header class="site-header">
  <div class="nav">
    <div class="brand">
      <a class="mark" href="/">DevRev<b>あるある</b></a>
      <span class="badge-unofficial">非公式ファンサイト</span>
    </div>
    <nav class="nav-links" aria-label="メイン">
      {
        nav.map((item) => (
          <a class="nav-text-link" href={item.href}>
            {item.label}
          </a>
        ))
      }
      <a class="nav-search" href="/aruaru" aria-label="あるあるを探す">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M21 21l-4.3-4.3"></path>
        </svg>
      </a>
      <button class="theme-toggle" id="themeToggle" type="button" aria-label="テーマ切り替え">
        <span id="themeLabel">Dark</span>
      </button>
    </nav>
  </div>
</header>

<script>
  function syncThemeLabel() {
    const label = document.getElementById('themeLabel');
    if (!label) return;
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    label.textContent = isDark ? 'Light' : 'Dark';
  }

  function applyTheme(theme: 'light' | 'dark') {
    if (theme === 'dark') {
      document.documentElement.setAttribute('data-theme', 'dark');
    } else {
      document.documentElement.removeAttribute('data-theme');
    }
    try {
      localStorage.setItem('aruaru-theme', theme);
    } catch {
      /* ignore */
    }
    syncThemeLabel();
  }

  syncThemeLabel();

  document.getElementById('themeToggle')?.addEventListener('click', () => {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    applyTheme(isDark ? 'light' : 'dark');
  });
</script>
