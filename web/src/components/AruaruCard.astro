---
import type { AruaruEntry } from '../lib/entries';
import FrequencyMeter from './FrequencyMeter.astro';
import TagPill from './TagPill.astro';

interface Props {
  entry: AruaruEntry;
}

const { entry } = Astro.props;
const titleId = `card-title-${entry.slug}`;
---

<article class="card">
  <a
    class="card-stretched-link"
    href={`/aruaru/${entry.slug}`}
    aria-labelledby={titleId}
  ></a>
  <div class="card-top">
    <FrequencyMeter frequency={entry.frequency} />
    <span class="cat">{entry.category}</span>
  </div>
  <h3 id={titleId}>{entry.title}</h3>
  <p>{entry.symptom}</p>
  <div class="tags">
    {entry.tags.map((tag) => (
      <TagPill href={`/tags/${encodeURIComponent(tag)}`} label={tag} />
    ))}
  </div>
</article>
