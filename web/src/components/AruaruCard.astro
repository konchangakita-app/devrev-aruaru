---
import type { AruaruEntry } from '../lib/entries';
import FrequencyMeter from './FrequencyMeter.astro';
import TagPill from './TagPill.astro';

interface Props {
  entry: AruaruEntry;
}

const { entry } = Astro.props;
---

<article class="card">
  <div class="card-top">
    <FrequencyMeter frequency={entry.frequency} />
    <span class="cat">{entry.category}</span>
  </div>
  <h3>
    <a href={`/aruaru/${entry.slug}`}>{entry.title}</a>
  </h3>
  <p>{entry.symptom}</p>
  <div class="tags">
    {entry.tags.map((tag) => (
      <TagPill href={`/tags/${encodeURIComponent(tag)}`} label={tag} />
    ))}
  </div>
</article>
