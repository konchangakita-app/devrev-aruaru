---
import type { AruaruEntry } from '../lib/entries';

interface Props {
  entry: AruaruEntry;
}

const { entry } = Astro.props;
---

<article class="rounded-lg border border-slate-800 bg-slate-900/50 p-5">
  <h2 class="text-lg font-semibold text-slate-100">
    <a href={`/aruaru/${entry.slug}`} class="hover:text-amber-300">{entry.title}</a>
  </h2>
  <p class="mt-2 text-sm text-slate-400 line-clamp-2">{entry.symptom}</p>
  <div class="mt-3 flex flex-wrap gap-2">
    {entry.tags.map((tag) => (
      <a href={`/tags/${encodeURIComponent(tag)}`} class="rounded bg-slate-800 px-2 py-0.5 text-xs text-amber-300/90 hover:bg-slate-700">
        {tag}
      </a>
    ))}
  </div>
</article>
