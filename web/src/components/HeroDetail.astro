---
import type { AruaruEntry } from '../lib/entries';
import FrequencyMeter from './FrequencyMeter.astro';

interface Props {
  entry: AruaruEntry;
}

const { entry } = Astro.props;
---

<header class="entry-header">
  <nav class="entry-breadcrumb" aria-label="パンくず">
    <a href="/">トップ</a>
    <span aria-hidden="true">/</span>
    <a href="/aruaru">あるある</a>
    <span aria-hidden="true">/</span>
    <span>{entry.category}</span>
  </nav>
  <h1 class="entry-header__title">{entry.title}</h1>
  <div class="entry-meta">
    <FrequencyMeter frequency={entry.frequency} />
    <span class="entry-meta__cat">{entry.category}</span>
    <span class="entry-meta__dot" aria-hidden="true">•</span>
    <time class="entry-meta__date" datetime={entry.publishedAt}>{entry.publishedAt}</time>
  </div>
</header>
