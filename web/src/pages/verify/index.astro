---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AruaruCard from '../../components/AruaruCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getCollection } from 'astro:content';

const verifications = (await getCollection('verifications')).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
---

<BaseLayout title="検証してみた | DevRevあるある" description="DevRevの機能・連携を実際に検証した記録">
  <section class="block">
    <div class="section-head">
      <h2>検証してみた</h2>
      <span class="legacy-muted">{verifications.length} 件</span>
    </div>
    <p class="legacy-muted verify-lead">手順・結果・学びを記事形式でまとめています。</p>

    {
      verifications.length === 0 ? (
        <EmptyState
          title="検証記事はまだありません"
          message="あるあると同様、順次追加していきます。"
        >
          <a class="btn btn-outline" href="/aruaru">あるあるを見る</a>
        </EmptyState>
      ) : (
        <div class="verify-list">
          {verifications.map((item) => (
            <div class="verify-item">
              <a href={`/verify/${item.id}`}>{item.data.title}</a>
              <p>{item.data.excerpt}</p>
              <time datetime={item.data.publishedAt.toISOString()}>
                {item.data.publishedAt.toISOString().slice(0, 10)}
              </time>
            </div>
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
