---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AruaruListPane from '../../components/AruaruListPane.astro';
import { getCategories, getEntries } from '../../lib/entries';

const entries = getEntries();
const categories = getCategories();
const activeCategory = Astro.url.searchParams.get('category') ?? undefined;
---

<BaseLayout title="あるある一覧 | DevRevあるある" description="DevRevのハマりどころ・回避策の一覧">
  <section class="block">
    <div class="section-head">
      <h2>あるある一覧</h2>
      <span class="legacy-muted">{entries.length} 件</span>
    </div>
    <AruaruListPane categories={categories} entries={entries} activeCategory={activeCategory} />
  </section>
</BaseLayout>
