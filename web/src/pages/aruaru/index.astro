---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AruaruCard from '../../components/AruaruCard.astro';
import { getEntries } from '../../lib/entries';

const entries = getEntries();
---

<BaseLayout title="あるある一覧 | DevRevあるある" description="DevRevのハマりどころ・回避策の一覧">
  <h1 class="legacy-page-title">あるある一覧</h1>
  <p class="legacy-muted">{entries.length} 件</p>

  <div class="mt-8 space-y-4">
    {entries.map((entry) => <AruaruCard entry={entry} />)}
  </div>
</BaseLayout>
