---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AruaruCard from '../../components/AruaruCard.astro';
import { getEntries } from '../../lib/entries';

const entries = getEntries();
---

<BaseLayout title="あるある一覧 | DevRevあるある" description="DevRevのハマりどころ・回避策の一覧">
  <section class="block">
    <div class="section-head">
      <h2>あるある一覧</h2>
      <span class="legacy-muted">{entries.length} 件</span>
    </div>
    <div class="cards">
      {entries.map((entry) => (
        <AruaruCard entry={entry} />
      ))}
    </div>
  </section>
</BaseLayout>
