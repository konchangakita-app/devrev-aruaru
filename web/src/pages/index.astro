---
import BaseLayout from '../layouts/BaseLayout.astro';
import AruaruCard from '../components/AruaruCard.astro';
import CategoryWindows from '../components/CategoryWindows.astro';
import HeroHome from '../components/HeroHome.astro';
import { getCategoryGroups, getEntries } from '../lib/entries';
import { getCollection } from 'astro:content';

const entries = getEntries().slice(0, 3);
const categoryGroups = getCategoryGroups();
const verifications = (await getCollection('verifications'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 2);
---

<BaseLayout title="DevRevあるある">
  <HeroHome slot="hero" />

  <section class="block">
    <div class="section-head">
      <h2>新着あるある</h2>
      <a href="/aruaru">すべて見る →</a>
    </div>
    <div class="cards">
      {entries.map((entry) => (
        <AruaruCard entry={entry} />
      ))}
    </div>
  </section>

  {
    categoryGroups.length > 0 && (
      <section class="block block--tight">
        <div class="section-head">
          <h2>カテゴリ別で探す</h2>
          <a href="/aruaru">カテゴリ一覧 →</a>
        </div>
        <CategoryWindows groups={categoryGroups} />
      </section>
    )
  }

  <section class="block">
    <div class="section-head">
      <h2>検証してみた</h2>
      <a href="/verify">すべて見る →</a>
    </div>
    {
      verifications.map((item) => (
        <div class="verify-item">
          <a href={`/verify/${item.id}`}>{item.data.title}</a>
          <p>{item.data.excerpt}</p>
        </div>
      ))
    }
  </section>
</BaseLayout>
