---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AruaruCard from '../../components/AruaruCard.astro';
import { getAllTags, getEntriesByTag } from '../../lib/entries';

export function getStaticPaths() {
  return getAllTags().map((tag) => ({
    params: { tag },
    props: { tag, entries: getEntriesByTag(tag) },
  }));
}

const { tag, entries } = Astro.props;
---

<BaseLayout title={`${tag} | DevRevあるある`}>
  <section class="block">
    <div class="section-head">
      <h2>タグ: {tag}</h2>
      <span class="legacy-muted">{entries.length} 件</span>
    </div>
    <div class="cards">
      {entries.map((entry) => (
        <AruaruCard entry={entry} />
      ))}
    </div>
  </section>
</BaseLayout>
