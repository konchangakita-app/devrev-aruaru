---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntries } from '../lib/entries';

const entries = getEntries();
---

<BaseLayout title="検索 | DevRevあるある" description="DevRevあるあるをキーワード検索">
  <script
    id="search-entries-data"
    type="application/json"
    set:html={JSON.stringify(entries).replace(/</g, '\\u003c')}
  />

  <section class="block block--search">
    <div class="search-page" data-search-page>
      <div class="search-toolbar">
        <div class="section-head section-head--search">
          <h2 data-search-heading>あるあるを検索</h2>
          <span class="legacy-muted" data-search-count hidden></span>
        </div>

        <form class="search-form" role="search" action="/search/" method="get">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="M21 21l-4.3-4.3"></path>
          </svg>
          <input
            type="search"
            name="q"
            data-search-input
            placeholder="キーワード（例: GitHub, スナップイン, OAuth）"
            aria-label="検索キーワード"
            autofocus
          />
          <button type="submit" class="btn btn-primary">検索</button>
        </form>

        <p class="search-hint" data-search-hint>
          タイトル・症状・原因・対処・カテゴリ・タグから検索します（あいまい一致）。
        </p>
      </div>

      <div class="search-body" data-search-body hidden>
        <p class="search-body-label" data-search-body-label hidden>一致したあるある</p>
        <div class="pane-list search-results" data-search-results hidden></div>
        <div data-search-empty hidden></div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/search-page.ts';
</script>
