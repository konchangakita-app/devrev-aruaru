---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntries } from '../lib/entries';

const entries = getEntries();
---

<BaseLayout title="検索 | DevRevあるある" description="DevRevあるあるをキーワード検索">
  <script
    id="search-entries-data"
    type="application/json"
    set:html={JSON.stringify(entries).replace(/</g, '\\u003c')}
  />

  <section class="block block--search">
    <div class="search-page" data-search-page>
      <div class="search-toolbar">
        <header class="search-header">
          <h1 class="search-header__title">あるあるを検索</h1>
          <p class="search-header__hint" data-search-hint>
            タイトル・症状・原因・対処・カテゴリ・タグから検索します（あいまい一致）。
          </p>
        </header>

        <form class="hero-search search-form--page" role="search" action="/search/" method="get">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="M21 21l-4.3-4.3"></path>
          </svg>
          <input
            type="search"
            name="q"
            data-search-input
            placeholder="キーワード（例: GitHub, スナップイン, OAuth）"
            aria-label="検索キーワード"
            autofocus
          />
          <button type="submit">検索</button>
        </form>
      </div>

      <div class="search-body" data-search-body hidden>
        <div class="search-body__inner">
          <p class="search-body__meta" data-search-meta hidden></p>
          <div class="search-results" data-search-results hidden></div>
          <div data-search-empty hidden></div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/search-page.ts';
</script>
